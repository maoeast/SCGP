{
  "name": "scgp",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "author": "杭州炫灿科技有限公司",
  "description": "星愿能力发展平台 (Stellar Competency Growth Platform)",
  "copyright": "©2013-2026 杭州炫灿科技有限公司",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev-start.js",
    "dev:simple": "node kill-port-5173.js && vite",
    "dev:force": "vite --port 5173 --force",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "type-check:emotional": "vue-tsc --noEmit -p tsconfig.emotional.json",
    "refresh:emotion-scene-names": "node scripts/refresh-emotion-scene-character-names.mjs",
    "verify:emotion-scene-phase1": "node scripts/verify-emotion-scene-phase1.mjs",
    "test:core:node": "node --test scripts/tests/assessment-scale-catalog.test.mjs scripts/tests/assessment-report-center-catalog.test.mjs scripts/tests/access-visibility.test.mjs scripts/tests/training-route-access.test.mjs scripts/tests/resource-center-business.test.mjs scripts/tests/update-module-contract.test.mjs scripts/tests/update-provider-config.test.mjs scripts/tests/ai-builtin-agent-presets-contract.test.mjs scripts/tests/ai-skill-library-contract.test.mjs scripts/tests/ai-skill-localization-contract.test.mjs scripts/tests/backup-restore-result.test.mjs scripts/tests/ai-secrets-contract.test.mjs scripts/tests/ai-provider-backup-redaction.test.mjs",
    "test:core:ts": "npx jiti tests/entitlement-catalog.test.ts && npx jiti tests/resource-file-refs.test.ts && npx jiti tests/crypto-bytes.test.ts",
    "verify:core": "npm run type-check && npm run test:core:node && npm run test:core:ts",
    "verify:release": "npm run verify:core && npm run build:web",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "electron": "electron .",
    "electron:dev": "node scripts/electron-dev-start.js",
    "build:electron": "npm run build:web && electron-builder",
    "build:web": "cross-env ELECTRON=true vite build",
    "build:electron:win": "npm run build:web && electron-builder --win",
    "build:electron:mac": "npm run build:web && electron-builder --mac",
    "build:electron:linux": "npm run build:web && electron-builder --linux",
    "generate:activation": "node scripts/generate-activation.js",
    "resource-copy:export": "node scripts/export-training-resource-copy-template.cjs",
    "resource-copy:build": "node scripts/build-training-resource-copy.cjs",
    "resource-copy:sync": "node scripts/sync-training-resource-copy.cjs",
    "reset:legacy-training-records": "node scripts/hard-cut-training-records.cjs",
    "reset:sensory-equipment": "node scripts/reset-sensory-equipment-resources.cjs",
    "import:physical-equipment": "node scripts/import-physical-equipment-resources.cjs"
  },
  "build": {
    "appId": "com.sic.ads",
    "productName": "SCGP 星愿能力发展训练系统",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "assets/resources",
        "to": "assets/resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "!dist/worker-test.html",
      "!dist/webgazer.js",
      "!dist/public-key.pem",
      "!dist/fontawesome-local.css",
      "!dist/sql.js-loader.js",
      "!dist/sql-wasm.js",
      "!dist/sql-wasm.wasm",
      "!dist/fontawesome/js/**/*",
      "!dist/fontawesome/less/**/*",
      "!dist/fontawesome/scss/**/*",
      "!dist/fontawesome/metadata/**/*",
      "!dist/fontawesome/sprites/**/*",
      "!dist/fontawesome/svgs/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "http://124.220.104.199/scgp/win"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "scgp-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.medical"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Medical"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@mediapipe/tasks-vision": "^0.10.34",
    "@types/uuid": "^10.0.0",
    "crypto-js": "^4.2.0",
    "docx": "^9.5.1",
    "dompurify": "^3.4.12",
    "echarts": "^6.0.0",
    "electron-updater": "^6.8.3",
    "element-plus": "^2.12.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "howler": "^2.2.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.3.0",
    "msedge-tts": "^2.0.4",
    "pdfjs-dist": "^6.1.200",
    "pinia": "^3.0.4",
    "sql.js": "^1.13.0",
    "three": "^0.183.2",
    "tone": "^15.1.22",
    "uuid": "^13.0.0",
    "vue": "^3.5.25",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/howler": "^2.2.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "better-sqlite3": "^12.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "~10.5.1",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "terser": "^5.44.1",
    "typescript": "~5.9.0",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.5",
    "wait-on": "^8.0.5"
  }
}
