{
  "name": "scgp-license-generator",
  "version": "1.1.1",
  "description": "SCGP 激活码 GUI 发码工具",
  "main": "main.js",
  "scripts": {
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win nsis"
  },
  "keywords": [
    "electron",
    "scgp",
    "license"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^23.3.13",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.scgp.license-generator",
    "productName": "SCGP 激活码生成工具",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "generate-license.js",
      ".keys/**/*",
      "public-key.pem"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "differentialPackage": false
    },
    "compression": "normal"
  }
}
